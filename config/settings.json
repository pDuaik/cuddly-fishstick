{
  "projectName": "cuddly-fishstick",
  "stage": "dev",
  "enableWaf": false,

  "domain": "example.com",

  "cloudFrontCertArnUsEast1": "arn:aws:acm:us-east-1:123456789012:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx",
  "cognitoDomainCertArn": "arn:aws:acm:eu-west-2:123456789012:certificate/yyyyyyyy-yyyy-yyyy-yyyy-yyyyyyyyyyyy",

  "cloudFrontPublicKeyPemPath": "keys/cloudfront_public_key.pem",

  "cfKeyPairId": "K1234567890ABCDE",
  "cfPrivateKeySecretArn": "arn:aws:secretsmanager:eu-west-2:123456789012:secret:cloudfront-private-key-abc123",
  "cfCookieDomain": ".example.com",
  "cfCookiePath": "/",
  "cfCookieTtlSeconds": 3600,

  "originVerifyHeaderName": "X-Origin-Verify",
  "originVerifyHeaderValue": "CHANGE_ME_TO_A_RANDOM_SECRET_STRING",

  "extraApiRoutes": []
}
